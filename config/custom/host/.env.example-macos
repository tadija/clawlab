# Copy to config/custom/host/.env and edit for each machine.

# Run specific agents on this host.
AELAB_AGENTS="001 002 003 004 005 006 007 020 021 022 023 024"

# Run shared infrastructure on this host.
AELAB_SERVICES="core"

# Environment
AELAB_HOST=dev-server
AELAB_USER=agent
AELAB_GROUP=staff
AELAB_ROOT=/Users/Shared/aelab
AELAB_PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
AELAB_PROJECTS="aelab=/Users/Shared/aelab"

# Restrict generated Caddy routes to Tailscale and localhost.
AELAB_TAILSCALE_ONLY=false
