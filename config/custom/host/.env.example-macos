# Copy to config/custom/host/.env and edit for each machine.

# Run specific agents on this host.
CLAWLAB_AGENTS="001 002 003 004 005 006 007 020 021 022 023 024"

# Run shared infrastructure on this host.
CLAWLAB_SERVICES="caddy"

# Environment
CLAWLAB_HOST=dev-server
CLAWLAB_USER=agent
CLAWLAB_GROUP=staff
CLAWLAB_ROOT=/Users/Shared/clawlab
CLAWLAB_PATH=/usr/local/bin:/usr/bin:/bin
CLAWLAB_PROJECTS="clawlab=/Users/Shared/clawlab"

# Restrict generated Caddy routes to Tailscale and localhost.
CLAWLAB_TAILSCALE_ONLY=false
