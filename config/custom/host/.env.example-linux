# Copy to config/custom/host/.env and edit for each machine.

# Run specific agents on this host.
AELAB_AGENTS="000 008 020 021 022 023 024"

# Run shared infrastructure on this host.
AELAB_SERVICES="core"

# Environment
AELAB_HOST=app-server
AELAB_USER=agent
AELAB_GROUP=agent
AELAB_ROOT=/srv/aelab
AELAB_PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/home/linuxbrew/.linuxbrew/bin
AELAB_PROJECTS="aelab=/srv/aelab"

# Restrict generated Caddy routes to Tailscale and localhost.
AELAB_TAILSCALE_ONLY=false
