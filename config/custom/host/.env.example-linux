# Copy to config/custom/host/.env and edit for each machine.

# Run specific agents on this host.
CLAWLAB_AGENTS="000 008 020 021 022 023 024"

# Run shared infrastructure on this host.
CLAWLAB_SERVICES="caddy"

# Environment
CLAWLAB_HOST=app-server
CLAWLAB_USER=agent
CLAWLAB_GROUP=agent
CLAWLAB_ROOT=/srv/clawlab
CLAWLAB_PATH=/usr/local/bin:/usr/bin:/bin:/home/linuxbrew/.linuxbrew/bin
CLAWLAB_PROJECTS="clawlab=/srv/clawlab"

# Restrict generated Caddy routes to Tailscale and localhost.
CLAWLAB_TAILSCALE_ONLY=false
