CLAWLAB_SERVICE_ID="tailscale"
CLAWLAB_SERVICE_DESCRIPTION="Tailscale node agent"
CLAWLAB_SERVICE_BIN="tailscaled"
CLAWLAB_SERVICE_BREW_PACKAGES="tailscale"
CLAWLAB_SERVICE_ARGS='--state="__CLAWLAB_SERVICE_DIR__/tailscaled.state"'
CLAWLAB_SERVICE_STOP_COMMAND="/bin/sh -c 'pkill -TERM -x tailscaled || true'"
CLAWLAB_SERVICE_AFTER="network-online.target"
CLAWLAB_SERVICE_WANTS="network-online.target"
CLAWLAB_SERVICE_RESTART_SEC="5s"
