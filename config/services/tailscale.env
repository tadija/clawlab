AELAB_SERVICE_ID="tailscale"
AELAB_SERVICE_DESCRIPTION="Tailscale node agent"
AELAB_SERVICE_BIN="tailscaled"
AELAB_SERVICE_BREW_PACKAGES="tailscale"
AELAB_SERVICE_ARGS='--state="__AELAB_SERVICE_DIR__/tailscaled.state"'
AELAB_SERVICE_STOP_COMMAND="/bin/sh -c 'pkill -TERM -x tailscaled || true'"
AELAB_SERVICE_AFTER="network-online.target"
AELAB_SERVICE_WANTS="network-online.target"
AELAB_SERVICE_RESTART_SEC="5s"
