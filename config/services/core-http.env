AELAB_SERVICE_ID="core-http"
AELAB_SERVICE_DESCRIPTION="aelab HTTP server"
AELAB_SERVICE_BIN="__AELAB_ROOT__/infra/generated/bin/aelab-http"
AELAB_SERVICE_INSTALL_KIND="script"
AELAB_SERVICE_INSTALL_SCRIPT="infra/utils/installers/core-http.sh"
AELAB_SERVICE_WORKING_DIRECTORY="__AELAB_ROOT__"
AELAB_SERVICE_ARGS='--repo-root "__AELAB_ROOT__" --bind 127.0.0.1 --port __SERVICE_PORT__'
AELAB_SERVICE_AFTER="network-online.target"
AELAB_SERVICE_WANTS="network-online.target"
AELAB_SERVICE_USER="__AELAB_USER__"
AELAB_SERVICE_GROUP="__AELAB_GROUP__"
AELAB_SERVICE_CADDY_ROUTE="/"
AELAB_SERVICE_CADDY_UPSTREAM="127.0.0.1:__SERVICE_PORT__"
