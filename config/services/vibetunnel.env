CLAWLAB_SERVICE_ID="vibetunnel"
CLAWLAB_SERVICE_DESCRIPTION="VibeTunnel web terminal server"
CLAWLAB_SERVICE_BIN="__CLAWLAB_ROOT__/infra/utils/vibetunnel-server.sh"
CLAWLAB_SERVICE_BREW_CASKS_MACOS_ARM64="vibetunnel"
CLAWLAB_SERVICE_INSTALL_OPTIONAL="true"
CLAWLAB_SERVICE_INSTALL_KIND="script"
CLAWLAB_SERVICE_INSTALL_SCRIPT="infra/installers/vibetunnel.sh"
CLAWLAB_SERVICE_WORKING_DIRECTORY="__CLAWLAB_SERVICE_DIR__"
CLAWLAB_SERVICE_ENV="HOME=__CLAWLAB_SERVICE_DIR__/home|VIBETUNNEL_CONTROL_DIR=__CLAWLAB_SERVICE_DIR__/home/.vibetunnel/control"
CLAWLAB_SERVICE_STATE_DIRS="__CLAWLAB_SERVICE_DIR__/home/.vibetunnel/control"
CLAWLAB_SERVICE_ARGS='--bind 127.0.0.1 --port 4020'
CLAWLAB_SERVICE_AFTER="network-online.target"
CLAWLAB_SERVICE_WANTS="network-online.target"
CLAWLAB_SERVICE_USER="__CLAWLAB_USER__"
CLAWLAB_SERVICE_GROUP="__CLAWLAB_GROUP__"
CLAWLAB_SERVICE_CADDY_ROUTE=":__SERVICE_PORT__"
CLAWLAB_SERVICE_CADDY_UPSTREAM="127.0.0.1:4020"
