AELAB_SERVICE_ID="mongodb"
AELAB_SERVICE_DESCRIPTION="MongoDB server"
AELAB_SERVICE_BIN="__AELAB_ROOT__/infra/utils/launchers/mongodb-server.sh"
AELAB_SERVICE_BREW_TAPS="mongodb/brew"
AELAB_SERVICE_BREW_PACKAGES="mongodb/brew/mongodb-community@8.0"
AELAB_SERVICE_AFTER="network-online.target"
AELAB_SERVICE_WANTS="network-online.target"
AELAB_SERVICE_ARGS='--port __SERVICE_PORT__'
AELAB_SERVICE_STATE_DIRS="__AELAB_SERVICE_DIR__/data"
AELAB_SERVICE_USER="__AELAB_USER__"
AELAB_SERVICE_GROUP="__AELAB_GROUP__"
