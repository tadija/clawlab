CLAWLAB_SERVICE_ID="mongodb"
CLAWLAB_SERVICE_DESCRIPTION="MongoDB server"
CLAWLAB_SERVICE_BIN="__CLAWLAB_ROOT__/infra/utils/mongodb-server.sh"
CLAWLAB_SERVICE_BREW_TAPS="mongodb/brew"
CLAWLAB_SERVICE_BREW_PACKAGES="mongodb/brew/mongodb-community@8.0"
CLAWLAB_SERVICE_AFTER="network-online.target"
CLAWLAB_SERVICE_WANTS="network-online.target"
CLAWLAB_SERVICE_ARGS='--port __SERVICE_PORT__'
CLAWLAB_SERVICE_STATE_DIRS="__CLAWLAB_SERVICE_DIR__/data"
CLAWLAB_SERVICE_USER="__CLAWLAB_USER__"
CLAWLAB_SERVICE_GROUP="__CLAWLAB_GROUP__"
