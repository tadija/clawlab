CLAWLAB_SERVICE_ID="nats"
CLAWLAB_SERVICE_DESCRIPTION="NATS server"
CLAWLAB_SERVICE_BIN="nats-server"
CLAWLAB_SERVICE_BREW_PACKAGES="nats-server"
CLAWLAB_SERVICE_ARGS='-a 127.0.0.1 -p __SERVICE_PORT__ -m 8222 -js -sd "__CLAWLAB_SERVICE_DIR__/jetstream" -P "__CLAWLAB_SERVICE_DIR__/nats-server.pid"'
CLAWLAB_SERVICE_AFTER="network-online.target"
CLAWLAB_SERVICE_WANTS="network-online.target"
CLAWLAB_SERVICE_STATE_DIRS="__CLAWLAB_SERVICE_DIR__/jetstream"
CLAWLAB_SERVICE_USER="__CLAWLAB_USER__"
CLAWLAB_SERVICE_GROUP="__CLAWLAB_GROUP__"
