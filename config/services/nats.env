AELAB_SERVICE_ID="nats"
AELAB_SERVICE_DESCRIPTION="NATS server"
AELAB_SERVICE_BIN="nats-server"
AELAB_SERVICE_BREW_PACKAGES="nats-server"
AELAB_SERVICE_ARGS='-a 127.0.0.1 -p __SERVICE_PORT__ -m 8222 -js -sd "__AELAB_SERVICE_DIR__/jetstream" -P "__AELAB_SERVICE_DIR__/nats-server.pid"'
AELAB_SERVICE_AFTER="network-online.target"
AELAB_SERVICE_WANTS="network-online.target"
AELAB_SERVICE_STATE_DIRS="__AELAB_SERVICE_DIR__/jetstream"
AELAB_SERVICE_USER="__AELAB_USER__"
AELAB_SERVICE_GROUP="__AELAB_GROUP__"
