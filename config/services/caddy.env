CLAWLAB_SERVICE_ID="caddy"
CLAWLAB_SERVICE_DESCRIPTION="Caddy web server"
CLAWLAB_SERVICE_BIN="caddy"
CLAWLAB_SERVICE_BREW_PACKAGES="caddy"
CLAWLAB_SERVICE_USER="__CLAWLAB_USER__"
CLAWLAB_SERVICE_GROUP="__CLAWLAB_GROUP__"
CLAWLAB_SERVICE_WORKING_DIRECTORY="__CLAWLAB_ROOT__/infra"
CLAWLAB_SERVICE_ENV="HOME=__CLAWLAB_SERVICE_DIR__/home|XDG_DATA_HOME=__CLAWLAB_SERVICE_DIR__|XDG_CONFIG_HOME=__CLAWLAB_SERVICE_DIR__/config"
CLAWLAB_SERVICE_ARGS='run --config "__CLAWLAB_ROOT__/infra/generated/Caddyfile" --adapter caddyfile'
CLAWLAB_SERVICE_RELOAD_ARGS='reload --config "__CLAWLAB_ROOT__/infra/generated/Caddyfile" --adapter caddyfile'
CLAWLAB_SERVICE_CADDY_ROOT_SERVICE_IDS="dash-http dash-tty"
CLAWLAB_SERVICE_AFTER="network-online.target"
CLAWLAB_SERVICE_WANTS="network-online.target"
CLAWLAB_SERVICE_STATE_DIRS="__CLAWLAB_SERVICE_DIR__/home __CLAWLAB_SERVICE_DIR__/config/caddy __CLAWLAB_SERVICE_DIR__/caddy/locks __CLAWLAB_ROOT__/infra/generated __CLAWLAB_ROOT__/infra/generated/caddy"
CLAWLAB_SERVICE_SYSTEMD_AMBIENT_CAPABILITIES="CAP_NET_BIND_SERVICE"
CLAWLAB_SERVICE_SYSTEMD_CAPABILITY_BOUNDING_SET="CAP_NET_BIND_SERVICE"
CLAWLAB_SERVICE_SYSTEMD_NO_NEW_PRIVILEGES="true"
