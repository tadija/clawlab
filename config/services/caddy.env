AELAB_SERVICE_ID="caddy"
AELAB_SERVICE_DESCRIPTION="Caddy web server"
AELAB_SERVICE_BIN="caddy"
AELAB_SERVICE_BREW_PACKAGES="caddy"
AELAB_SERVICE_USER="__AELAB_USER__"
AELAB_SERVICE_GROUP="__AELAB_GROUP__"
AELAB_SERVICE_WORKING_DIRECTORY="__AELAB_ROOT__/infra"
AELAB_SERVICE_ENV="HOME=__AELAB_SERVICE_DIR__/home|XDG_DATA_HOME=__AELAB_SERVICE_DIR__|XDG_CONFIG_HOME=__AELAB_SERVICE_DIR__/config"
AELAB_SERVICE_ARGS='run --config "__AELAB_ROOT__/infra/generated/Caddyfile" --adapter caddyfile'
AELAB_SERVICE_RELOAD_ARGS='reload --config "__AELAB_ROOT__/infra/generated/Caddyfile" --adapter caddyfile'
AELAB_SERVICE_AFTER="network-online.target"
AELAB_SERVICE_WANTS="network-online.target"
AELAB_SERVICE_STATE_DIRS="__AELAB_SERVICE_DIR__/home __AELAB_SERVICE_DIR__/config/caddy __AELAB_SERVICE_DIR__/caddy/locks __AELAB_ROOT__/infra/generated"
AELAB_SERVICE_SYSTEMD_AMBIENT_CAPABILITIES="CAP_NET_BIND_SERVICE"
AELAB_SERVICE_SYSTEMD_CAPABILITY_BOUNDING_SET="CAP_NET_BIND_SERVICE"
AELAB_SERVICE_SYSTEMD_NO_NEW_PRIVILEGES="true"
