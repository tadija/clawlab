CLAWLAB_SERVICE_ID="dash"
CLAWLAB_SERVICE_DESCRIPTION="Clawlab dash renderer"
CLAWLAB_SERVICE_BIN="__CLAWLAB_ROOT__/infra/generated/bin/dash-server"
CLAWLAB_SERVICE_INSTALL_KIND="script"
CLAWLAB_SERVICE_INSTALL_SCRIPT="infra/installers/dash.sh"
CLAWLAB_SERVICE_WORKING_DIRECTORY="__CLAWLAB_ROOT__"
CLAWLAB_SERVICE_ARGS='--repo-root "__CLAWLAB_ROOT__" --bind 127.0.0.1 --port __SERVICE_PORT__'
CLAWLAB_SERVICE_AFTER="network-online.target"
CLAWLAB_SERVICE_WANTS="network-online.target"
CLAWLAB_SERVICE_USER="__CLAWLAB_USER__"
CLAWLAB_SERVICE_GROUP="__CLAWLAB_GROUP__"
CLAWLAB_SERVICE_CADDY_ROOT_UPSTREAM="127.0.0.1:__SERVICE_PORT__"
