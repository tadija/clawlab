CLAWLAB_AGENT_KIND="nanobot"
CLAWLAB_AGENT_HOME_ENV="HOME"
CLAWLAB_AGENT_ENV="NANOBOT_AGENTS__DEFAULTS__WORKSPACE=__AGENT_DIR__/workspace"
CLAWLAB_AGENT_BREW_PACKAGES="uv"
CLAWLAB_AGENT_INSTALL_KIND="script"
CLAWLAB_AGENT_INSTALL_SCRIPT="infra/installers/nanobot.sh"
CLAWLAB_AGENT_SETUP_ARGS="nanobot|onboard"
CLAWLAB_AGENT_TUI_ARGS="nanobot|agent"
CLAWLAB_AGENT_START_ARGS="nanobot|gateway"
CLAWLAB_AGENT_START_PORT_FLAG="--port"
CLAWLAB_AGENT_FORWARD_PREFIX="nanobot|__COMMAND__"
