AELAB_AGENT_KIND="nanobot"
AELAB_AGENT_HOME_ENV="HOME"
AELAB_AGENT_ENV="NANOBOT_AGENTS__DEFAULTS__WORKSPACE=__AGENT_DIR__/workspace"
AELAB_AGENT_BREW_PACKAGES="uv"
AELAB_AGENT_INSTALL_KIND="script"
AELAB_AGENT_INSTALL_SCRIPT="infra/utils/installers/nanobot.sh"
AELAB_AGENT_SETUP_ARGS="nanobot|onboard"
AELAB_AGENT_TUI_ARGS="nanobot|agent"
AELAB_AGENT_START_ARGS="nanobot|gateway"
AELAB_AGENT_START_PORT_FLAG="--port"
AELAB_AGENT_FORWARD_PREFIX="nanobot|__COMMAND__"
