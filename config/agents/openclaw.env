CLAWLAB_AGENT_KIND="openclaw"
CLAWLAB_AGENT_BREW_PACKAGES="openclaw-cli"
CLAWLAB_AGENT_HOME_ENV="OPENCLAW_HOME"
CLAWLAB_AGENT_SETUP_ARGS="openclaw|setup"
CLAWLAB_AGENT_START_ARGS="openclaw|gateway"
CLAWLAB_AGENT_START_PORT_FLAG="--port"
CLAWLAB_AGENT_STOP_ARGS="openclaw|gateway|stop"
CLAWLAB_AGENT_FORWARD_PREFIX="openclaw"
