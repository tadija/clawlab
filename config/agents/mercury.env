CLAWLAB_AGENT_KIND="mercury"
CLAWLAB_AGENT_ENV="HOME=__AGENT_DIR__|MERCURY_HOME=__AGENT_DIR__/.mercury"
CLAWLAB_AGENT_INSTALL_KIND="script"
CLAWLAB_AGENT_INSTALL_SCRIPT="infra/installers/mercury.sh"
CLAWLAB_AGENT_SETUP_ARGS="mercury|setup"
CLAWLAB_AGENT_START_ARGS="mercury|start"
CLAWLAB_AGENT_STOP_ARGS="mercury|stop"
CLAWLAB_AGENT_FORWARD_PREFIX="mercury"
