AELAB_AGENT_KIND="mercury"
AELAB_AGENT_ENV="HOME=__AGENT_DIR__|MERCURY_HOME=__AGENT_DIR__/.mercury"
AELAB_AGENT_INSTALL_KIND="script"
AELAB_AGENT_INSTALL_SCRIPT="infra/utils/installers/mercury.sh"
AELAB_AGENT_SETUP_ARGS="mercury|setup"
AELAB_AGENT_START_ARGS="mercury|start"
AELAB_AGENT_STOP_ARGS="mercury|stop"
AELAB_AGENT_FORWARD_PREFIX="mercury"
