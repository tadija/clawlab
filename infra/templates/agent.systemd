[Unit]
Description=Agent %i
After=network-online.target
Wants=network-online.target

[Service]
User=__AELAB_USER__
Group=__AELAB_GROUP__
UMask=0002
WorkingDirectory=__AELAB_ROOT__
__PATH_BLOCK__
EnvironmentFile=-__AELAB_ROOT__/config/custom/env/agents.env
EnvironmentFile=-__AELAB_ROOT__/config/custom/env/agents/%i.env
ExecStart=__AELAB_ROOT__/ae %i start
Restart=always
RestartSec=3s
StandardOutput=append:__AELAB_ROOT__/state/logs/agent/%i.log
StandardError=append:__AELAB_ROOT__/state/logs/agent/%i.err

[Install]
WantedBy=multi-user.target
